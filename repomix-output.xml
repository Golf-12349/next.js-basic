                ))}
              </ul>
            </div>
          )}
        </div>

        {/* Submit status banner */}
        {submitStatus === "success" && (
          <div className="bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm rounded-lg px-3.5 py-2.5">
