@import "tailwindcss";

:root {
  --background: #ffffff;
  --foreground: #171717;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --font-sans: var(--font-noto-sans), var(--font-noto-sans-lao), sans-serif;
  --font-mono: var(--font-noto-sans), sans-serif;
}

@media (prefers-color-scheme: dark) {
  :root {
    --background: #0a0a0a;
    --foreground: #ededed;
  }
}

html {
  font-family: var(--font-noto-sans), var(--font-noto-sans-lao), sans-serif;
}

body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-noto-sans), var(--font-noto-sans-lao), sans-serif;
}

/* ---------- Dashboard: hide scrollbar on horizontal strips ---------- */
.no-scrollbar {
  -ms-overflow-style: none;
  scrollbar-width: none;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

/* ---------- Print styles ---------- */
@media print {
  body * {
    visibility: hidden;
  }
  #print-area,
  #print-area * {
    visibility: visible;
  }
  #print-area {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
  }
}

/* ---------- DMS Login: fluid background & floating glass bubbles ---------- */
@keyframes dms-drift {
  0%,
  100% {
    transform: translate(0px, 0px) scale(1);
  }
  33% {
    transform: translate(40px, -28px) scale(1.07);
  }
  66% {
    transform: translate(-28px, 24px) scale(0.95);
  }
}

@keyframes dms-float {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-14px);
  }
}

.dms-blob {
  animation: dms-drift 20s ease-in-out infinite;
}

.dms-blob-delayed {
  animation-delay: -7s;
}

.dms-blob-reverse {
  animation: dms-drift 26s ease-in-out infinite reverse;
}

.dms-bubble {
  animation: dms-float 6s ease-in-out infinite;
}

.dms-bubble-delay-1 {
  animation-delay: 1.4s;
}

.dms-bubble-delay-2 {
  animation-delay: 2.8s;
}
