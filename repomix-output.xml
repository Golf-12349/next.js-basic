            <p className="mt-1 text-sm text-gray-500">
              ລາຍການເອກະສານທີ່ຖືກລຶບຊົ່ວຄາວ ສາມາດກູ້ຄືນ ຫຼື ລຶບຖາວອນໄດ້
            </p>
          </div>

          {trash.length > 0 && (
            <div className="flex flex-wrap items-center gap-2">
              <button
                onClick={handleRestoreAll}
