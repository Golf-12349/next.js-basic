          <dl className="mt-5 grid gap-4 sm:grid-cols-2">
            <div className="rounded-lg border border-gray-100 bg-white p-3">
              <dt className="flex items-center gap-1.5 text-xs text-gray-500">
                <Building2 size={14} /> ພະແນກ
              </dt>
              <dd className="mt-1 text-sm font-semibold text-gray-900">{user.department || '—'}</dd>
            </div>
            <div className="rounded-lg border border-gray-100 bg-white p-3">
              <dt className="flex items-center gap-1.5 text-xs text-gray-500">
                <BadgeCheck size={14} /> ຕຳແໜ່ງ
              </dt>
              <dd className="mt-1 text-sm font-semibold text-gray-900">{user.position || '—'}</dd>
            </div>
            <div className="rounded-lg border border-gray-100 bg-white p-3">
              <dt className="flex items-center gap-1.5 text-xs text-gray-500">
                <Mail size={14} /> ອີເມວ
              </dt>
              <dd className="mt-1 break-all text-sm font-semibold text-gray-900">{user.email}</dd>
