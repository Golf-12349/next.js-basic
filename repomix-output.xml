"use client"
import { useEffect, useState } from 'react'
import Modal from '@/app/components/ui/Modal'
import { AlertTriangle, Building2, BadgeCheck, CalendarDays, Mail } from 'lucide-react'
import type { User, UserRole, UserStatus } from '@/types/user'

// ── Options ──────────────────────────────────────────────────
export const roleOptions: UserRole[] = ['SuperAdmin', 'Admin', 'User']

export const departmentOptions = [
  'ພະແນກບໍລິຫານ & ຈັດຕັ້ງ',
  'ພະແນກການເງິນ & ບັນຊີ',
  'ພະແນກໄອທີ & ເຕັກໂນໂລຊີ',
  'ພະແນກການຕະຫຼາດ & ຂາຍ',
  'ພະແນກແຜນການ & ໂຄງການ',
]

// ສີ avatar ທີ່ຈະສຸ່ມໃຫ້ຜູ້ໃຊ້ໃໝ່ (ຂຽນເປັນ class ເຕັມເພື່ອໃຫ້ Tailwind ເກັບໄດ້)
export const avatarPalette = [
  'bg-rose-500',
  'bg-purple-500',
  'bg-emerald-500',
  'bg-indigo-500',
  'bg-amber-500',
  'bg-cyan-500',
  'bg-teal-500',
  'bg-blue-500',
]

export function randomAvatarColor() {
  return avatarPalette[Math.floor(Math.random() * avatarPalette.length)]
}

// ── Shared helpers ───────────────────────────────────────────
export function getInitials(name: string) {
  const parts = name.trim().split(/\s+/).filter(Boolean)
  if (parts.length === 0) return '?'
  if (parts.length === 1) return parts[0].slice(0, 2)
  return `${parts[0][0]}${parts[1][0]}`
}

export const roleBadgeClass: Record<UserRole, string> = {
  SuperAdmin: 'bg-rose-50 text-rose-700 ring-1 ring-rose-200',
  Admin: 'bg-purple-50 text-purple-700 ring-1 ring-purple-200',
  User: 'bg-emerald-50 text-emerald-700 ring-1 ring-emerald-200',
}

export function RoleBadge({ role }: { role: UserRole }) {
  return (
    <span className={`inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ${roleBadgeClass[role]}`}>
      {role}
    </span>
  )
}

export function StatusBadge({ status }: { status: UserStatus }) {
  const active = status === 'active'
  return (
    <span
      className={`inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ${
        active ? 'bg-green-50 text-green-700 ring-1 ring-green-200' : 'bg-gray-100 text-gray-600 ring-1 ring-gray-200'
      }`}
    >
      <span className="relative flex h-2 w-2">
        {active && (
          <span className="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-500 opacity-75" />
        )}
        <span className={`relative inline-flex h-2 w-2 rounded-full ${active ? 'bg-green-500' : 'bg-gray-400'}`} />
      </span>
      {active ? 'ເປີດໃຊ້ງານ' : 'ປິດໃຊ້ງານ'}
    </span>
  )
}

export function Avatar({ user, size = 'md' }: { user: User; size?: 'md' | 'lg' }) {
  const sizeClass = size === 'lg' ? 'h-20 w-20 text-2xl' : 'h-10 w-10 text-sm'
  return (
    <div
      className={`flex shrink-0 items-center justify-center rounded-full font-bold uppercase text-white shadow-sm ${sizeClass} ${
        user.avatarColor ?? 'bg-indigo-500'
      }`}
    >
      {getInitials(user.name)}
    </div>
  )
}

// ── Form state shared by Add / Edit ──────────────────────────
export type UserFormValues = {
  name: string
  email: string
  role: UserRole
  department: string
  position: string
}

const emptyForm: UserFormValues = {
  name: '',
  email: '',
  role: 'User',
  department: '',
  position: '',
}

const inputClass =
  'w-full rounded-lg border border-gray-200 bg-gray-50 px-3 py-2 text-sm outline-none transition focus:border-indigo-400 focus:bg-white'

function Field({
  label,
  required,
  error,
  children,
}: {
  label: string
  required?: boolean
  error?: string
  children: React.ReactNode
}) {
  return (
    <div>
      <label className="mb-1 block text-sm font-medium text-gray-700">
        {label} {required && <span className="text-red-500">*</span>}
      </label>
      {children}
      {error && <p className="mt-1 text-xs text-red-500">{error}</p>}
    </div>
  )
}

function validate(values: UserFormValues) {
  const errors: Partial<Record<keyof UserFormValues, string>> = {}
  if (!values.name.trim()) errors.name = 'ກະລຸນາປ້ອນຊື່'
  if (!values.email.trim()) errors.email = 'ກະລຸນາປ້ອນອີເມວ'
  else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(values.email.trim())) errors.email = 'ຮູບແບບອີເມວບໍ່ຖືກຕ້ອງ'
  if (!values.department) errors.department = 'ກະລຸນາເລືອກພະແນກ'
  return errors
}

function UserForm({
  values,
  setValues,
  errors,
}: {
  values: UserFormValues
  setValues: React.Dispatch<React.SetStateAction<UserFormValues>>
  errors: Partial<Record<keyof UserFormValues, string>>
}) {
  return (
    <div className="space-y-4">
      <div className="grid gap-4 sm:grid-cols-2">
        <Field label="ຊື່ ແລະ ນາມສະກຸນ" required error={errors.name}>
          <input
            value={values.name}
            onChange={(e) => setValues((v) => ({ ...v, name: e.target.value }))}
            placeholder="ເຊັ່ນ: ທ້າວ ສົມພອນ"
            className={inputClass}
          />
        </Field>

        <Field label="ອີເມວ" required error={errors.email}>
          <input
            type="email"
            value={values.email}
            onChange={(e) => setValues((v) => ({ ...v, email: e.target.value }))}
            placeholder="name@company.com"
            className={inputClass}
          />
        </Field>
      </div>

      <div className="grid gap-4 sm:grid-cols-2">
        <Field label="ສິດການນຳໃຊ້ (Role)" required>
          <select
            value={values.role}
            onChange={(e) => setValues((v) => ({ ...v, role: e.target.value as UserRole }))}
            className={inputClass}
          >
            {roleOptions.map((r) => (
              <option key={r} value={r}>
                {r}
              </option>
            ))}
          </select>
        </Field>

        <Field label="ພະແນກ" required error={errors.department}>
          <select
            value={values.department}
            onChange={(e) => setValues((v) => ({ ...v, department: e.target.value }))}
            className={inputClass}
          >
            <option value="">— ເລືອກພະແນກ —</option>
            {departmentOptions.map((d) => (
              <option key={d} value={d}>
                {d}
              </option>
            ))}
          </select>
        </Field>
      </div>

      <Field label="ຕຳແໜ່ງ">
        <input
          value={values.position}
          onChange={(e) => setValues((v) => ({ ...v, position: e.target.value }))}
          placeholder="ເຊັ່ນ: ພະນັກງານທຸລະການ"
          className={inputClass}
        />
      </Field>
    </div>
  )
}

// ── User Detail Modal ────────────────────────────────────────
interface UserDetailModalProps {
  user: User | null
  onClose: () => void
}

export function UserDetailModal({ user, onClose }: UserDetailModalProps) {
  return (
    <Modal open={!!user} onClose={onClose} title="ຂໍ້ມູນຜູ້ໃຊ້ງານ">
      {user && (
        <div>
          {/* Profile header */}
          <div className="flex flex-col items-center gap-3 rounded-xl bg-gradient-to-br from-indigo-50 to-purple-50 p-6 text-center">
            <Avatar user={user} size="lg" />
            <div>
