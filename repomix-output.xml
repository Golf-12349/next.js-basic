// ── Add User Modal ───────────────────────────────────────────
interface AddUserModalProps {
  open: boolean
  onClose: () => void
  onSubmit: (values: UserFormValues) => void
}

export function AddUserModal({ open, onClose, onSubmit }: AddUserModalProps) {
  const [values, setValues] = useState<UserFormValues>(emptyForm)
  const [errors, setErrors] = useState<Partial<Record<keyof UserFormValues, string>>>({})

  useEffect(() => {
    if (open) {
      setValues(emptyForm)
      setErrors({})
    }
  }, [open])

  function handleSubmit() {
    const nextErrors = validate(values)
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) return
    onSubmit({
      ...values,
      name: values.name.trim(),
      email: values.email.trim(),
      position: values.position.trim(),
    })
  }

  return (
    <Modal open={open} onClose={onClose} title="ເພີ່ມຜູ້ໃຊ້ງານໃໝ່">
      <div className="space-y-4">
        <UserForm values={values} setValues={setValues} errors={errors} />
        <div className="flex justify-end gap-2 pt-2">
          <button
            onClick={onClose}
            className="rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200"
          >
            ຍົກເລີກ
          </button>
          <button
            onClick={handleSubmit}
            className="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
          >
            ບັນທຶກ
          </button>
        </div>
      </div>
    </Modal>
  )
}

// ── Edit User Modal ──────────────────────────────────────────
interface EditUserModalProps {
  user: User | null
  onClose: () => void
  onSubmit: (values: UserFormValues) => void
}

export function EditUserModal({ user, onClose, onSubmit }: EditUserModalProps) {
  const [values, setValues] = useState<UserFormValues>(emptyForm)
  const [errors, setErrors] = useState<Partial<Record<keyof UserFormValues, string>>>({})

  useEffect(() => {
    if (user) {
      setValues({
        name: user.name,
        email: user.email,
        role: user.role,
        department: user.department,
        position: user.position ?? '',
      })
      setErrors({})
    }
  }, [user])

  function handleSubmit() {
    const nextErrors = validate(values)
    setErrors(nextErrors)
    if (Object.keys(nextErrors).length > 0) return
    onSubmit({
      ...values,
      name: values.name.trim(),
      email: values.email.trim(),
      position: values.position.trim(),
    })
  }

  return (
    <Modal open={!!user} onClose={onClose} title="ແກ້ໄຂຂໍ້ມູນຜູ້ໃຊ້ງານ">
      {user && (
        <div className="space-y-4">
          <UserForm values={values} setValues={setValues} errors={errors} />
          <div className="flex justify-end gap-2 pt-2">
            <button
              onClick={onClose}
              className="rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-200"
            >
              ຍົກເລີກ
            </button>
            <button
              onClick={handleSubmit}
              className="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700"
            >
              ບັນທຶກການແກ້ໄຂ
            </button>
          </div>
        </div>
      )}
    </Modal>
  )
}

// ── Delete User Modal ────────────────────────────────────────
interface DeleteUserModalProps {
  user: User | null
  onClose: () => void
  onConfirm: () => void
