# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามต้องการ
# .env.local ไม่ถูก commit ขึ้น git (แต่ละเครื่องตั้งค่าของตัวเอง)

# URL ของ backend API
# ใส่ URL ของ backend ที่คุณใช้งานจริง เช่น https://your-backend-service.onrender.com/api
# ถ้ารันแบบ local ให้ใช้ http://localhost:3000/api แทน
NEXT_PUBLIC_API_URL=https://your-backend-service.onrender.com/api
    