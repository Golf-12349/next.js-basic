# คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าตามต้องการ
# .env.local ไม่ถูก commit ขึ้น git (แต่ละเครื่องตั้งค่าของตัวเอง)

# URL ของ backend API
# ค่า default ด้านล่างคือ backend ที่ deploy ไว้บน Render (ใช้งานได้เลย ไม่ต้องรัน backend local)
# ถ้าต้องการรัน backend local แทน (เช่นกำลังแก้โค้ด backend) ให้เปลี่ยนเป็น http://localhost:3000/api
NEXT_PUBLIC_API_URL=https://dms-backend-yrap.onrender.com/api
